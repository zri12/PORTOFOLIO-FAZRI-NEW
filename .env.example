# Server-only Vercel Function variables. Do not prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLIC_BUCKET=
SITE_URL=

# Public Vite variables. VITE_* values are bundled into the browser and are not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLIC_BUCKET=
VITE_ENABLE_SUPABASE=
VITE_ENABLE_REALTIME=
VITE_SITE_URL=

# Optional Admin username alias variables. These are public client configuration, not secrets.
VITE_ADMIN_USERNAME=
VITE_ADMIN_AUTH_EMAIL=
VITE_ADMIN_AUTH_DOMAIN=

# Development-only public Vite variable. Do not enable this in production.
VITE_ENABLE_DEV_ADMIN_MOCK=

# Server-only Supabase Edge Function translation variables. Configure as Supabase secrets.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_WORKER_SECRET=

# Server-only administrative script variables.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_AUTH_EMAIL=

# Never expose any of these through VITE_* variables:
# SUPABASE_SERVICE_ROLE_KEY
# TRANSLATION_API_KEY
# TRANSLATION_WORKER_SECRET
# Gemini API key or other Gemini secret
# Supabase PAT
# Database password
